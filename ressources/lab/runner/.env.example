# Copier en .env (gitignoré) et renseigner :
# URL du repo étudiant sur GitHub
REPO_URL=https://github.com/<vous>/taskflow-ops

# Token d'ENREGISTREMENT (valable 1 h) :
#   Settings → Actions → Runners → New self-hosted runner → section "Configure"
#   → copier la valeur qui suit `--token`
RUNNER_TOKEN=CHANGE_ME

# Alternative : un PAT (classic, scope `repo`) — l'image génère elle-même le
# token d'enregistrement, pratique pour redémarrer sans re-générer un token.
# ACCESS_TOKEN=ghp_xxx

RUNNER_NAME=lab-runner
# Les labels servent au `runs-on: [self-hosted, lab]` des workflows
LABELS=self-hosted,lab,ansible
