# {{ ansible_managed }}
[Unit]
Description=Prometheus node_exporter
After=network.target

[Service]
User={{ node_exporter_user }}
Group={{ node_exporter_user }}
ExecStart={{ node_exporter_bin }} --web.listen-address=:{{ node_exporter_port }} \
  --collector.systemd \
  --no-collector.hwmon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
