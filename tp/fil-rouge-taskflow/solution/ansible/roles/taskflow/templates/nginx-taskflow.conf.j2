# {{ ansible_managed }}
# Vhost nginx de {{ app_name }} ({{ app_env }})
#   /            → front statique (dist/ de la release courante)
#   /api/, /health, /metrics → API Node sur 127.0.0.1:{{ api_port }}
server {
    listen {{ app_http_port }};
    server_name {{ app_server_name }};

    root {{ app_current }}/dist;
    index index.html;

    access_log /var/log/nginx/{{ app_name }}_access.log;
    error_log  /var/log/nginx/{{ app_name }}_error.log;

    # SPA : toutes les routes inconnues retombent sur index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API : /api/*, /health et /metrics sont servis par Node sur 127.0.0.1:{{ api_port }}
    # (/health = smoke tests + blackbox_exporter ; /metrics = scrape Prometheus)
    location ~ ^/(api/|health$|metrics$) {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
