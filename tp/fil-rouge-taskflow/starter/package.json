{
  "name": "taskflow-ops",
  "version": "1.0.0",
  "description": "TaskFlow opérée - front Vite + API Express, fil rouge Automatisation CI & Monitoring",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/junit.xml --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": ["taskflow", "ansible", "prometheus", "formation"],
  "author": "ForEach Academy",
  "license": "MIT"
}
